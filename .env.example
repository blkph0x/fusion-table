# Optional local SERVER configuration for live location and shop data.
# Recipe generation is deterministic and requires no credentials or network calls.
# Copy either this file to .env OR .dev.vars.example to .dev.vars, not both.
# Keep actual provider credentials out of Git and browser code.

# The default map services work without API keys.
# PHOTON_API_URL=https://photon.komoot.io/api/
# PHOTON_REVERSE_API_URL=https://photon.komoot.io/reverse
# SHOP_DATA_PROVIDER=photon
# OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter

# Optional accounts: Node host only. Keep credentials in a 0600 server env file.
# Apply migrations/20261027-accounts.sql as an administrator first; the app user
# needs only SELECT, INSERT, UPDATE and DELETE on its own account database.
# FUSION_AUTH_DB_HOST=127.0.0.1
# FUSION_AUTH_DB_PORT=3307
# FUSION_AUTH_DB_NAME=fusion_accounts
# FUSION_AUTH_DB_USER=fusion_accounts
# FUSION_AUTH_DB_PASSWORD=your-unique-database-password
# FUSION_AUTH_ORIGIN=https://your-domain.example
# FUSION_AUTH_RATE_SECRET=your-random-secret-of-at-least-32-characters
# Set only when your reverse proxy overwrites this header with its peer address.
# FUSION_AUTH_PROXY_HEADER=x-fusion-client-ip
