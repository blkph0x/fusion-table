[Unit]
Description=Fusion Table anonymous retailer browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fusion-retailer
Group=fusion-retailer
WorkingDirectory=/opt/fusion-table
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1365x900x24 -nolisten tcp" /usr/bin/node /opt/fusion-table/scripts/retailer-browser.mjs
Environment=NODE_ENV=production
Environment=RETAILER_BROWSER_PORT=8794
Environment=RETAILER_BROWSER_HEADLESS=0
Environment=RETAILER_CHROMIUM_PATH=/usr/bin/chromium
Environment=RETAILER_COLES_STATE_FILE=/var/lib/fusion-retailer-browser/coles-state.json
Environment=RETAILER_COLES_SESSION_HOURS=8
Environment=HOME=/var/lib/fusion-retailer-browser
StateDirectory=fusion-retailer-browser
StateDirectoryMode=0700
RuntimeDirectory=fusion-retailer-browser
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
UMask=0077
TasksMax=256
MemoryMax=1536M
Restart=on-failure
RestartSec=5
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
